# Tenant PostgreSQL (used when the namespace has no postgres Service)
SAAS_PG_HOST=
SAAS_PG_PORT=5432
SAAS_PG_DATABASE=openmu
SAAS_PG_USER=postgres
SAAS_PG_PASSWORD=
# SAAS_PG_DSN=postgresql://postgres:admin@127.0.0.1:5432/openmu

# Lab guard — single tenant, 1 replica
SAAS_LAB_MODE=true
SAAS_LAB_NAMESPACE=openmu-lab
SAAS_MAX_TENANTS=1

# Lab Kubernetes API. Auth is a local kubeconfig (chmod 600), never git.
SAAS_K8S_API_SERVER=https://62.216.75.149:6443
SAAS_K8S_TLS_SERVER_NAME=api.test-01.k8s.t-h.cloud
# SAAS_KUBECONFIG=/tmp/kubeconfig
# KUBECONFIG=/tmp/kubeconfig
# SAAS_KUBE_CONTEXT=
# Optional worker IP for NodePort display (do not list Node objects on this shared cluster)
# SAAS_K8S_NODE_IP=185.126.137.16

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
