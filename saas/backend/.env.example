# Tenant PostgreSQL (used when the namespace has no postgres Service)
SAAS_PG_HOST=
SAAS_PG_PORT=5432
SAAS_PG_DATABASE=openmu
SAAS_PG_USER=postgres
SAAS_PG_PASSWORD=
# SAAS_PG_DSN=postgresql://postgres:admin@127.0.0.1:5432/openmu

# Lab guard — single tenant, 1 replica
SAAS_LAB_MODE=true
SAAS_LAB_NAMESPACE=openmu-lab
SAAS_MAX_TENANTS=1

# Lab Kubernetes API (public host:6443 — not a secret). Auth stays in a local kubeconfig.
SAAS_K8S_API_SERVER=https://api.test-01.k8s.t-h.cloud:6443
# Same API via the control-plane public IP: https://62.216.75.149:6443
#
# Point at a kubeconfig you keep outside git (tokens/certs/keys must not be committed):
# SAAS_KUBECONFIG=/path/to/lab.kubeconfig
# KUBECONFIG=/path/to/lab.kubeconfig
# Optional worker IP for NodePort display (do not list Node objects on this shared cluster)
# SAAS_K8S_NODE_IP=185.126.137.16

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
